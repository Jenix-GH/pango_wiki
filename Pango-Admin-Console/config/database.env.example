# MySQL connection used only by the Node server.
PANGO_DB_HOST=127.0.0.1
PANGO_DB_PORT=3306
PANGO_DB_NAME=agent_db
PANGO_DB_USER=pango_console
PANGO_DB_PASSWORD=replace_with_database_password

PANGO_PUBLIC_ORIGIN=https://aiapp.pangomicro.com

# Use 0.0.0.0 only when remote access is required and the server firewall is configured.
ADMIN_CONSOLE_HOST=127.0.0.1
ADMIN_CONSOLE_PORT=3100

# Generate these values with: node scripts/generate-admin-credentials.mjs
ADMIN_CONSOLE_USER=pango_admin
ADMIN_CONSOLE_PASSWORD_HASH=pbkdf2-sha256$210000$replace_with_salt$replace_with_hash
ADMIN_CONSOLE_SESSION_HOURS=12

# Set true only when the console is served through HTTPS.
ADMIN_CONSOLE_COOKIE_SECURE=false

# Apply all migrations in database/ (including 20260924_license_manual_status.sql) before enabling.
LICENSE_DELIVERY_ENABLED=false
# Enable only after SMTP, recipient, historical records and cron have been checked.
LICENSE_SEND_ENABLED=false
LICENSE_FAE_EMAIL=replace-with-fae@example.com
LICENSE_REPLY_TO=replace-with-fae@example.com
# Platform SMTP account: sends digest/results only to LICENSE_FAE_EMAIL.
LICENSE_MAIL_ENV=/home/sjchen/license-notify/.env
# Prefer the admin Mail Settings UI to save the FAE account securely.
# Optional file fallback: MAIL_ADDRESS must equal LICENSE_FAE_EMAIL.
# Customer licenses and rejection notices use this account; no platform fallback.
LICENSE_FAE_MAIL_ENV=/home/sjchen/license-notify/fae.env
LICENSE_PYTHON=/usr/bin/python3
