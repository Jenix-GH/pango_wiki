# MySQL connection used only by the Node server.
PANGO_DB_HOST=127.0.0.1
PANGO_DB_PORT=3306
PANGO_DB_NAME=agent_db
PANGO_DB_USER=pango_console
PANGO_DB_PASSWORD=replace_with_database_password

PANGO_PUBLIC_ORIGIN=https://aiapp.pangomicro.com

# Use 0.0.0.0 only when remote access is required and the server firewall is configured.
ADMIN_CONSOLE_HOST=127.0.0.1
ADMIN_CONSOLE_PORT=3100

# Generate these values with: node scripts/generate-admin-credentials.mjs
ADMIN_CONSOLE_USER=pango_admin
ADMIN_CONSOLE_PASSWORD_HASH=pbkdf2-sha256$210000$replace_with_salt$replace_with_hash
ADMIN_CONSOLE_SESSION_HOURS=12

# Set true only when the console is served through HTTPS.
ADMIN_CONSOLE_COOKIE_SECURE=false
