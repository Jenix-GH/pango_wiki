/**app.wxss**/
.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 200rpx 0;
  box-sizing: border-box;
} 

page {
    --bg-primary: rgb(150, 12, 115);      /* 主色调 */
    --bg-white: white;    /* 副色调 */
    --bg-light :rgb(247, 247, 247);
    --success-color: #28a745;      /* 成功色 */
    --text-dark: #333;             /* 主要文字颜色 */
    --text-mark: rgb(139, 139, 139);   /* 浅色文字 */
    --text-light: #ccc;            /* 浅色文字 */
    --bg-mask: rgba(0, 0, 0, 0.5); /*遮罩层 */
}


