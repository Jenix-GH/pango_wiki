.company{
    flex: 1;
    overflow-y: hidden;
    background-color: var(--bg-light);
    height: calc(100vh - 350rpx);
}
.company-container{
    color: var(--text-dark);
    padding: 10rpx 50rpx 30rpx 50rpx;
    line-height: 60rpx;
    font-size: 95%;
}
.company .icontent{
    text-indent: 2em;
}
.last-bottom{
    text-align: center;
    margin-top: 50rpx;
    font-size: 90%;
    color: var(--text-light);
}