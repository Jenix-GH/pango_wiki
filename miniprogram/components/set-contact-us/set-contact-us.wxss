.company{
    flex: 1;
    overflow-y: hidden;
    background-color: var(--bg-light);
    height: calc(100vh - 350rpx);
}
.company-container{
    color: var(--text-dark);
    padding: 10rpx 50rpx 30rpx 50rpx;
    line-height: 40rpx;
    font-size: 95%;
}
 .title {
    color: var(--bg-primary);
    font-weight: bold;
    padding: 5rpx;
    padding-left: 20rpx;
    border-left: 10rpx solid var(--bg-primary);
    margin-bottom: 10rpx;
    margin-top: 40rpx;

}

.content {
    padding: 8rpx;
    font-size: 90%;
}

.last-bottom{
    text-align: center;
    margin-top: 50rpx;
    font-size: 90%;
    color: var(--text-light);
}