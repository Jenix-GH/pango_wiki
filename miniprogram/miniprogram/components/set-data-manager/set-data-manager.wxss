
.dataManager .sub {
    padding: 30rpx;
}

.dataManager .subItem {
    padding: 20rpx;
    background-color: var(--bg-white);
    border-radius: 20rpx;
    display: flex;
    justify-content: space-between;
    height: 60rpx;
    line-height: 60rpx;
}

.dataManager .subItem .item {
    height: 60rpx;
    line-height: 60rpx;
}

.dataManager .subMark {
    font-size: 80%;
    padding: 20rpx;
    color: var(--text-dark);
}

.dataManager .redItem {
    color: red;
}