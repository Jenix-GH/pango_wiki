/* user-info子组件样式 */
.userForm {
    background-color: var(--bg-white);
    min-height: 100%;
    margin-top: 20rpx;
    box-sizing: border-box;
}

.userForm .formItem {
    display: flex;
    padding: 30rpx;
    border-bottom: 1px solid var(--bg-light);
    font-size: 32rpx;
    align-items: center;
}

.ilabel {
    width: 170rpx;
    flex-shrink: 0;
    line-height: 44rpx;
}

.userForm input {
    flex: 1;
    min-width: 0;
    font-size: 32rpx;
    line-height: 44rpx;
}

.userForm .formButton {
    padding: 40rpx;
}

.userForm .formButton .ibtn {
    width: 70%;
    padding: 30rpx;
    border-radius: 30rpx;
    transition: opacity 0.3s ease-in-out;
    width: 80%;
    background-color: var(--bg-primary);
    color: white;
}
