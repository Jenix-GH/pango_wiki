
.leftMask {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 998;
    background: rgba(17, 24, 39, 0.38);
    opacity: 0;
}

.leftPanel {
    position: fixed;
    top: 0;
    bottom: 0;
    width: 82%;
    max-width: 610rpx;
    height: 100vh;
    left: -82%;
    background: white;
    z-index: 999;
    box-shadow: 15rpx 0 50rpx rgba(15, 23, 42, 0.2);
    box-sizing: border-box;
    overflow: hidden;
}

.left-panel-container {
    width: 100%;
    height: 100%;
    padding: 25rpx;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
}

.left-panel-container-auth {
    padding: 0;
}

.left-panel-header {
    min-height: 106rpx;
    padding: 0 28rpx 18rpx;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-shrink: 0;
    border-bottom: 1rpx solid #e1e6ed;
    color: #273247;
    font-size: 31rpx;
    font-weight: 700;
    box-sizing: border-box;
}

.left-panel-close {
    width: 58rpx;
    height: 58rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #7a8493;
    border-radius: 50%;
    font-size: 44rpx;
    line-height: 1;
    font-weight: 400;
}

.left-panel-close:active {
    background: #f0f2f5;
}

.left-panel-title {
    color: var(--text-mark);
    font-size: 80%;
    padding-bottom: 10rpx;
    padding-top: 30rpx;
}

.left-panel-nohis {
    text-align: center;
    padding: 100rpx;
    font-weight: bold;
}

.left-panel-his {
    height: 0;
    min-height: 0;
    flex: 1;
    padding: 20rpx 20rpx 0;
    overflow-y: auto;
    width: 100%;
    box-sizing: border-box;
}

.data-group {
    font-size: 90%;
}

.data-group-text {
    font-size: 85%;
}

.data-item {
    display: flex;
    align-items: center;
    gap: 12rpx;
    font-size: 95%;
    color: var(--text-dark);
    transition: height 0.2s ease;
    padding: 20rpx;
    border-left: 4rpx solid white;
}

.data-item-text {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.data-item-delete {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56rpx;
    height: 56rpx;
    border-radius: 12rpx;
}

.data-item-delete--pressed {
    background: rgba(138, 143, 152, 0.12);
}

.data-item.active-style {
    background-color: var(--bg-light);
    border-left: 4rpx solid var(--bg-primary);
    font-size: 95%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--text-dark);
    padding: 20rpx;
}

.left-panel-set{
    display: flex;
    align-items: center;
    flex-shrink: 0;
    min-width: 0;
    padding: 22rpx 24rpx calc(env(safe-area-inset-bottom) + 22rpx);
    border-top: 1rpx solid #e5e9ef;
    background: #fff;
    box-sizing: border-box;
}

.left-panel-set .userImgs {
    flex-shrink: 0;
}

.left-panel-set .userImgs .imgs {
    height: 70rpx;
    width: 70rpx;
    border-radius: 50%;
}

.left-panel-set .userImgs .default-avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #eef0f3;
    border: 1rpx solid #d5d9de;
    box-sizing: border-box;
}

.left-panel-set .userName {
    flex: 1;
    min-width: 0;
    height: 70rpx;
    line-height: 70rpx;
    padding: 0 20rpx;
    font-size: 90%;
    color: var(--text-dark);
    font-weight: bold;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.left-panel-set .setImgs {
    width: 60rpx;
    height: 60rpx;
    padding: 8rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-sizing: border-box;
}

.btn-primary {
    background-color: var(--bg-primary);
    color: white;
}

.privacy-mask {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 9999;
}

.privacy-dialog {
    width: 80%;
    max-height: 70vh;
    background: white;
    border-radius: 20rpx;
    padding: 30rpx;
    box-sizing: border-box;
    color: var(--text-dark);
    display: flex;
    flex-direction: column;
}

.privacy-content {
    flex: 1;
    overflow-y: auto;
    font-size: 28rpx;
    line-height: 1.8;
    margin-bottom: 30rpx;
}

.privacy-content view {
    text-indent: 2em;
}

.privacy-link {
    color: var(--bg-primary);
}

.privacy-buttons {
    display: flex;
    justify-content: space-between;
    flex-shrink: 0;
}
.privacy-title{
    text-align: center; padding: 30rpx; font-weight: bold;
}

.privacy-button {
    flex: 1;
    margin: 0 10rpx;
}
