.panel {
    position: relative;
    flex-shrink: 0;
    color: #303238;
    background: #fff;
    border-bottom: 1rpx solid #e5e7eb;
    box-sizing: border-box;
}

.panel-toolbar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
}

.panel-actions {
    position: absolute;
    left: 16rpx;
    top: 0;
    bottom: 0;
    display: flex;
    align-items: center;
}

.panel-actions-hidden {
    visibility: hidden;
}

.panel-action {
    width: 58rpx;
    height: 58rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12rpx;
}

.panel-action:active {
    background: #f4f4f5;
}

.panel-brand {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10rpx;
    max-width: 430rpx;
}

.panel-logo {
    width: 54rpx;
    height: 54rpx;
    flex-shrink: 0;
}

.panel-brand-title {
    color: #17191c;
    font-size: 29rpx;
    line-height: 40rpx;
    font-weight: 650;
    white-space: nowrap;
}

.panel-tabs {
    height: 88rpx;
    padding: 0 20rpx;
    display: grid;
    grid-template-columns: 1fr 1.28fr 1.2fr;
    align-items: center;
    gap: 10rpx;
    border-top: 1rpx solid #f0f1f3;
    box-sizing: border-box;
}

.panel-tab {
    height: 68rpx;
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10rpx;
    color: #555a61;
    font-size: 26rpx;
    white-space: nowrap;
    border-radius: 14rpx;
}

.panel-tab.active {
    color: #a10c79;
    background: #f9ebf5;
    font-weight: 600;
}

.panel-tab:active {
    opacity: .72;
}

.panel-tab-icon {
    width: 34rpx;
    height: 34rpx;
    flex-shrink: 0;
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
}

