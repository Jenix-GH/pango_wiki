<!--自定义菜单-->
<top-menu activeTab="chat" showChatActions="{{true}}" iconName="{{pageLeftIconName}}" bind:openLeftPanel="showLeftPanel" bind:reloadSession="reloadSession" bind:openChat="noop" bind:openWiki="openWiki" bind:openLicense="openLicense" />
<!--左侧抽屉页面 -->
<left-menu id="leftPanel" dataDayTitle="{{dataDayTitle}}" dataHisTitle="{{dataHisTitle}}" userInfo="{{userInfo}}" bind:openSetPanel="showSetPanel" bind:doSearchHisItem="doSearchHisItem" bind:deleteHistoryItem="deleteHistoryItem" bind:refresh="handleRefresh" bind:panelVisibilityChange="onLeftPanelVisibilityChange" />
<!--底部设置页面-->
<set-menu id="setPanel" bind:logout="logout"></set-menu>
<!--主页-->
<!-- 录音的松手/系统中断兜底挂在整个内容区上：长按输入框时若手指移出输入框矩形，
     touchend 不再派发到那个 view，只有靠这里冒泡到的大范围监听才能结束录音。 -->
<view class="main-container" style="padding-bottom:{{keyboardPadding}}px" bindtouchend="recordTouchEnd" bindtouchcancel="recordTouchCancel">
    <!-- <scroll-view class="scrollarea" scroll-y scroll-with-animation scroll-into-view="{{scrollToId}}"> -->
    <scroll-view class="scrollarea" scroll-y scroll-into-view="{{scrollToId}}" scroll-top="{{scrollTop}}" bindscroll="onScroll">
        <!--顶部的提示问题列表-->
        <view wx:if="{{flagShowTip}}" class="tip-panel">
            <view class="tip-title">很高兴遇见你，你可以这样问</view>
            <view wx:for="{{tipData}}" wx:key="index">
                <view class="tip-item" bind:tap="fastSearch" data-content="{{item.content}}">{{item.content}}</view>
            </view>
        </view>
        <view wx:for="{{sessionList}}" wx:for-index="messageIndex" wx:key="index">
            <!--左侧内容-->
            <view wx:if="{{item.flagAi === 1}}" class="main-session main-session-left">
                <view class="main-session-icon">
                    <view class="main-session-bg">
                        <view class="logo"></view>
                    </view>
                    <view class="username">{{aiName}}</view>
                </view>
                <view class="show-answer">
                    <view class="show-content">
                        <block wx:for="{{item.answerSections}}" wx:for-item="section" wx:key="section_key">
                            <mp-html wx:if="{{section.content}}" content="{{section.content}}" markdown latex highlight selectable="force" tag-style="{{tagStyle}}" />
                            <view wx:if="{{section.media && section.media.length}}" class="answer-figure-panel">
                                <block wx:for="{{section.media}}" wx:for-item="media" wx:key="asset_id">
                                    <view class="answer-figure-item">
                                        <image class="answer-figure-image" src="{{media.absoluteUrl}}" mode="widthFix" lazy-load bind:tap="previewReferenceFigure" data-message-index="{{messageIndex}}" data-url="{{media.absoluteUrl}}" />
                                        <view wx:if="{{media.caption || media.citation_label}}" class="answer-figure-caption">{{media.caption}} {{media.citation_label}}</view>
                                        <view wx:if="{{media.document_page_url && media.page}}" class="answer-figure-source" catch:tap="openPageReference" data-url="{{media.document_page_url}}">查看原文第{{media.page}}页</view>
                                    </view>
                                </block>
                            </view>
                        </block>
                        <view wx:if="{{item.reference && item.reference.total > 0}}" class="reference-panel">
                            <view class="reference-title">参考资料 · {{item.reference.total}}篇</view>
                            <block wx:for="{{item.reference.chunks}}" wx:for-item="ref" wx:key="reference_key">
                                <view class="reference-card">
                                    <view class="reference-card-header">
                                        <view class="reference-name">{{ref.citation_label}} {{ref.display_name}}</view>
                                    </view>
                                    <view wx:if="{{ref.page_links && ref.page_links.length > 0}}" class="reference-pages">
                                        <text class="reference-pages-label">引用页：</text>
                                        <block wx:for="{{ref.page_links}}" wx:for-item="pl" wx:key="page_key">
                                            <view
                                                class="reference-page-link"
                                                hover-class="reference-action-active"
                                                catch:tap="openPageReference"
                                                data-url="{{pl.document_page_url}}"
                                                aria-role="button"
                                                aria-label="查看第{{pl.page}}页"
                                            ><text wx:if="{{pl.citation_label}}">{{pl.citation_label}} </text>第{{pl.page}}页</view>
                                        </block>
                                    </view>
                                    <view wx:elif="{{ref.pages && ref.pages.length > 0}}" class="reference-pages">
                                        <text class="reference-pages-label">引用页：</text>
                                        <block wx:for="{{ref.pages}}" wx:for-item="pg" wx:key="*this">
                                            <text class="reference-page-num">第{{pg}}页</text>
                                        </block>
                                    </view>
                                    <view wx:elif="{{ref.page}}" class="reference-pages">
                                        <text class="reference-pages-label">引用页：</text>
                                        <text class="reference-page-num">第{{ref.page}}页</text>
                                    </view>
                                </view>
                            </block>
                        </view>
                    </view>
                </view>
                <view class="session-icon-time bottom-menu">
                    <view style="padding-right: 20rpx;">{{item.time}}</view>
                    <view class="bottom-menu-item" bind:tap="doCopy" data-contentData="{{item.contentData}}">
                        <view class="fuzhi"></view>
                    </view>
                    <view class="bottom-menu-item" bind:tap="doEvaluate" data-evaluate="1" data-index="{{messageIndex}}" data-dotime="{{item.time}}">
                        <view class="{{item.flagEvaluate==='1' ? 'zan1' : 'zan'}}"></view>
                    </view>
                    <view class="bottom-menu-item" bind:tap="doEvaluate" data-evaluate="-1" data-index="{{messageIndex}}" data-dotime="{{item.time}}">
                        <view class="{{item.flagEvaluate==='-1'? 'cai1' : 'cai'}}"></view>
                    </view>
                    <view class="bottom-menu-item feedback-entry" bind:tap="openFeedback" data-index="{{messageIndex}}">反馈</view>
                </view>
            </view>
            <!--右侧内容-->
            <view wx:if="{{item.flagAi === 0}}" class="main-session main-session-right">
                <view class="main-session-content" bind:longpress="doCopyQuestion" data-content="{{item.content}}">
                    <view wx:if="{{item.images && item.images.length > 0}}" class="chat-image-list">
                            <image wx:for="{{item.images}}" wx:for-item="img" wx:for-index="imgIdx" wx:key="index" class="chat-image-thumb" src="{{img.local_url || 'data:' + img.mime_type + ';base64,' + img.data_base64}}" mode="aspectFill" style="border-radius:16rpx;overflow:hidden" bind:tap="previewChatImage" data-images="{{item.images}}" data-index="{{imgIdx}}" />
                    </view>
                    <text wx:if="{{item.content}}">{{item.content}}</text>
                </view>
                <view class="session-icon-time">{{item.time}}</view>
            </view>
        </view>
        <!--实时回答内容-->
        <view wx:if="{{flagStart}}" class="main-session main-session-left">
            <view class="main-session-icon">
                <view class="main-session-bg">
                    <view class="logo"></view>
                </view>
                <view class="username">{{aiName}}</view>
            </view>
            <agent-progress
                wx:if="{{flagStart && !streamContent}}"
                phase="{{currentPhase}}"
                title="{{currentStatusText}}"
                detail="{{currentStatusDetail}}"
            />
            <view class="show-answer">
                <view class="show-content">
                    <mp-html content="{{streamContent}}" markdown latex highlight selectable="force" class="mp-html contenttow" id="markdownContent" tag-tyle="{{tagStyle}}" />
                </view>
            </view>
        </view>
        <view id="bottomAnchor"></view> <!-- 底部锚点元素 -->
    </scroll-view>

    <!-- 底部输入组件 -->
    <view class="input-wrapper">
        <view hidden="{{!userScrolledUp}}" class="main-to-bottom" bind:tap="toBottom">
            <iconfont name="xiala" size="25" />
        </view>
        <!-- 音波效果 -->
        <view hidden="{{!flagLuyuning}}" class="yinbo">
            <view class="shuohua_big"></view>
            <!-- 波纹层 -->
            <view class="ripple ripple-1"></view>
            <view class="ripple ripple-2"></view>
            <view class="ripple ripple-3"></view>
        </view>
        <view>
            <!-- 测试版按钮 -->
            <!-- <view class="function-type-group">
                <view class="function-type-item {{isTestVersion == true ? 'choose-type-item' : ''}}" bind:tap="chooseType">测试版</view>
            </view> -->
            <!-- 输入行：图片按钮 + 文本框 + 语音按钮 + 发送按钮 -->
            <view class="input-container">
                <view wx:if="{{!flagLuyuning && !flagVoiceMode}}" class="image-upload-btn" bind:tap="chooseImage">
                    <view class="image-icon"></view>
                </view>
                <view style="flex:1; min-width:0;" class="textarea-wrap">
                    <view wx:if="{{uploadImages.length > 0 && !flagVoiceMode}}" class="image-preview-list">
                        <view wx:for="{{uploadImages}}" wx:key="index" class="image-preview-item">
                            <image class="image-preview-thumb" src="{{item.local_url || 'data:' + item.mime_type + ';base64,' + item.data_base64}}" mode="aspectFill" style="border-radius:10rpx;overflow:hidden" />
                            <view class="image-preview-remove" bind:tap="removeImage" data-index="{{index}}">×</view>
                        </view>
                    </view>
                    <!-- 输入区：普通 view 负责显示内容并撑住高度，textarea 常驻并绝对定位覆盖其上。
                         触摸事件统一挂在这一层：无论手指起始落在普通 view 还是上层的原生 textarea 上，
                         都能冒泡到这里处理，避免只绑在 view 上时某些位置长按后收不到 move/end。 -->
                    <view
                        class="input-area"
                        bind:tap="activateInput"
                        bindtouchstart="recordTouchStart"
                        bindtouchend="recordTouchEnd"
                        catchtouchmove="recordTouchMove"
                        bindtouchcancel="recordTouchCancel"
                    >
                        <!-- 非输入态：用普通 view 呈现输入框内容。这里不涉及原生组件，
                             所以长按不会唤起键盘。输入态下它转为不可见但仍保留，负责撑住输入区高度。 -->
                        <view
                            wx:if="{{!flagVoiceMode}}"
                            class="input-proxy {{inputActive ? 'input-proxy-ghost' : ''}} {{flagLuyuning ? 'input-proxy-recording' : ''}}"
                        >
                            <text wx:if="{{flagLuyuning}}">{{luyunTipText}}</text>
                            <text wx:elif="{{questionContent}}" class="input-proxy-text">{{questionContent}}</text>
                            <text wx:else class="input-proxy-placeholder">{{inputPlaceholder}}</text>
                        </view>
                        <!-- textarea 常驻渲染：非输入态停在屏幕外（首次布局也发生在屏幕外，
                             首帧抖动因此不可见），输入态只切换 left 覆盖到 view 上，
                             宽度始终是 100%，不会触发任何重新计算。 -->
                        <textarea
                            wx:if="{{!flagVoiceMode && !flagLeftPanelOpen}}"
                            class="textarea {{inputActive ? '' : 'textarea-offscreen'}}"
                            auto-height
                            focus="{{inputFocus}}"
                            placeholder="{{inputPlaceholder}}"
                            bindinput="doReady"
                            confirm-type="send"
                            disable-default-padding
                            show-confirm-bar="{{false}}"
                            bindconfirm="doSearch"
                            cursor-spacing="{{0}}"
                            adjust-position="{{false}}"
                            value="{{questionContent}}"
                            id="myInput"
                            maxlength="-1"
                            bindfocus="onInputFocus"
                            bindblur="onInputBlur"
                        />
                    </view>
                    <!-- 语音模式：按住说话 -->
                    <view hidden="{{!flagVoiceMode}}" class="talkView-active" bindtouchstart="startRecord" catchtouchmove="cancelRecord" catchtouchend="stopRecord" catchtouchcancel="cancelRecordBySystem">
                        {{luyunTipText}}
                    </view>
                </view>
                <view wx:if="{{flagStart === false && !flagLuyuning}}" class="voice-btn" bind:tap="toggleVoiceMode">
                    <view class="voice-icon {{flagVoiceMode ? 'voice-icon-active' : ''}}"></view>
                </view>
                <view wx:if="{{flagStart === false}}" class="send-btn {{flagDoReady?'send-btn-ready':''}}" bind:tap="doSearch">
                    <view class="send"></view>
                </view>
                <view wx:if="{{flagStart === true}}" class="send-btn send-btn-stop" bind:tap="stopStreaming">
                    <view class="stop"></view>
                </view>
            </view>
        </view>
        <!-- 提示信息 -->
        <view class="question-bottom-text">内容由AI生成，仅供参考</view>
    </view>
</view>

<view wx:if="{{feedbackVisible}}" class="feedback-mask" catch:tap="closeFeedback">
    <view class="feedback-dialog" catch:tap="stopPropagation">
        <view class="feedback-close" bind:tap="closeFeedback">×</view>
        <view class="feedback-kicker">回答质量反馈</view>
        <view class="feedback-title">告诉我们哪里需要改进</view>
        <view class="feedback-desc">反馈将与本次问题和 AI 回答一起提交，帮助我们持续改进回答质量。</view>
        <view class="feedback-label">问题类型</view>
        <view class="feedback-types">
            <view wx:for="{{feedbackTypeOptions}}" wx:key="*this" class="feedback-type {{feedbackType === item ? 'selected' : ''}}" bind:tap="chooseFeedbackType" data-type="{{item}}">{{item}}</view>
        </view>
        <view class="feedback-label">补充说明 <text>必填</text></view>
        <textarea class="feedback-textarea" maxlength="2000" value="{{feedbackDetail}}" bindinput="inputFeedbackField" data-field="feedbackDetail" placeholder="请说明具体问题，例如：器件参数不准确，正确值应为……" />
        <view class="feedback-label">补充图片 <text>选填，限 1 张，最大 15MB</text></view>
        <view wx:if="{{feedbackImage}}" class="feedback-image-preview">
            <image src="{{feedbackImage.local_url}}" mode="aspectFit" bind:tap="previewFeedbackImage" />
            <view class="feedback-image-remove" bind:tap="removeFeedbackImage">删除图片</view>
        </view>
        <view wx:else class="feedback-image-add" bind:tap="chooseFeedbackImage">上传截图或照片</view>
        <view class="feedback-label">联系方式 <text>联系人必填，方便工程师进一步联系</text></view>
        <view class="feedback-contact-grid">
            <input maxlength="100" value="{{feedbackContactName}}" bindinput="inputFeedbackField" data-field="feedbackContactName" placeholder="联系人（必填）" />
            <input maxlength="200" value="{{feedbackCompanyName}}" bindinput="inputFeedbackField" data-field="feedbackCompanyName" placeholder="公司名称" />
            <input maxlength="200" value="{{feedbackEmail}}" bindinput="inputFeedbackField" data-field="feedbackEmail" placeholder="电子邮箱" />
            <input maxlength="50" value="{{feedbackPhone}}" bindinput="inputFeedbackField" data-field="feedbackPhone" placeholder="联系电话" />
        </view>
        <view class="feedback-actions">
            <button class="feedback-cancel" bind:tap="closeFeedback">暂不反馈</button>
            <button class="feedback-submit" loading="{{feedbackSubmitting}}" disabled="{{feedbackSubmitting}}" bind:tap="submitFeedback">提交反馈</button>
        </view>
    </view>
</view>
