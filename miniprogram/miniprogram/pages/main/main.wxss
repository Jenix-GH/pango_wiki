/* 底部固定容器 */
.input-wrapper {
  padding: 0 20rpx 25rpx;
  box-sizing: border-box;
  z-index: 95;
  background-color: var(--bg-light);
  flex-shrink: 0;
}

.input-container {
  display: flex;
  align-items: center;
  background: white;
  border-radius: 20rpx;
  padding: 10rpx;
  margin-bottom: 10rpx;
}

.textarea-wrap {
  padding: 20rpx 15rpx;
  box-sizing: border-box;
}

.textarea {
  width: 100%;
  min-height: 40rpx;
  max-height: 200rpx;
  line-height: 40rpx;
  box-sizing: border-box;
}



