page { height: 100vh; display: flex; flex-direction: column; color: #263247; background: #f4f7fb; }
.license-scroll { flex: 1; min-height: 0; }
.license-main { padding: 24rpx 20rpx 0; box-sizing: border-box; }
.license-card { padding: 32rpx 24rpx 38rpx; border: 1rpx solid #dde5ef; border-radius: 16rpx; background: #fff; box-shadow: 0 10rpx 30rpx rgba(25, 52, 85, .07); }
.license-heading { display: flex; flex-direction: column; }
.license-kicker { color: #a10c79; font-size: 23rpx; font-weight: 700; }
.license-title { margin-top: 8rpx; color: #172033; font-size: 39rpx; line-height: 52rpx; font-weight: 700; }
.license-description { margin-top: 9rpx; color: #68758a; font-size: 25rpx; line-height: 42rpx; }
.form-section { position: relative; margin-top: 44rpx; padding: 32rpx 0 12rpx; display: flex; flex-direction: column; gap: 28rpx; border-top: 1rpx solid #dce4ee; }
.section-title { position: absolute; top: -18rpx; left: 0; padding-right: 18rpx; color: #24344d; background: #fff; font-size: 28rpx; line-height: 36rpx; font-weight: 700; }
.field { display: flex; flex-direction: column; gap: 12rpx; color: #344258; font-size: 25rpx; font-weight: 600; }
.field input, .picker-field { height: 82rpx; padding: 0 21rpx; display: flex; align-items: center; justify-content: space-between; border: 1rpx solid #cbd6e3; border-radius: 9rpx; color: #1e293b; background: #fff; font-size: 26rpx; box-sizing: border-box; font-weight: 400; }
.field textarea { width: 100%; min-height: 166rpx; padding: 19rpx 21rpx; border: 1rpx solid #cbd6e3; border-radius: 9rpx; color: #1e293b; background: #fff; font-size: 26rpx; box-sizing: border-box; font-weight: 400; }
.license-options { display: flex; flex-direction: column; gap: 16rpx; }
.license-option { min-height: 102rpx; padding: 18rpx 17rpx; display: flex; align-items: center; gap: 15rpx; border: 1rpx solid #d2dce8; border-radius: 10rpx; box-sizing: border-box; }
.license-option.selected { border-color: #a10c79; background: #fbf0f8; }
.radio-dot { width: 30rpx; height: 30rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border: 2rpx solid #aab5c3; border-radius: 50%; box-sizing: border-box; }
.license-option.selected .radio-dot { border-color: #a10c79; }
.license-option.selected .radio-dot view { width: 16rpx; height: 16rpx; border-radius: 50%; background: #a10c79; }
.option-title, .option-description { display: block; }
.option-title { color: #25334a; font-size: 25rpx; font-weight: 700; }
.option-description { margin-top: 5rpx; color: #718096; font-size: 20rpx; font-weight: 400; }
.form-message { margin-top: 25rpx; padding: 20rpx 22rpx; border-radius: 9rpx; font-size: 25rpx; line-height: 38rpx; }
.form-message.error { color: #b42318; background: #fff0ee; }
.form-message.success { color: #157347; background: #eaf8f0; }
.submit-button { height: 82rpx; margin-top: 28rpx; padding: 0; display: flex; align-items: center; justify-content: center; border-radius: 9rpx; color: #fff; background: #a10c79; font-size: 27rpx; font-weight: 700; line-height: 1; text-align: center; }
.submit-button::after { border: 0; }
.submit-button[disabled] { color: #fff; opacity: .6; }
.license-bottom-space { height: calc(env(safe-area-inset-bottom) + 30rpx); }
.license-link-button { margin: 24rpx 0 0; padding: 16rpx 20rpx; color: #8e176f; background: #faf0f7; font-size: 25rpx; line-height: 1.6; border-radius: 10rpx; }
.license-link-button::after { border: 0; }
.official-options { display: flex; flex-direction: column; gap: 16rpx; }
.official-choice { display: flex; align-items: center; min-height: 84rpx; padding: 12rpx 20rpx; border: 1rpx solid #cbd6e3; border-radius: 10rpx; box-sizing: border-box; font-weight: 400; }
.official-choice radio { margin-right: 16rpx; flex-shrink: 0; }
.official-choice.selected { border-color: #a10c79; background: #fbf0f8; }
.official-notice { padding: 18rpx 20rpx; color: #845319; background: #fff8e9; border-radius: 10rpx; font-size: 24rpx; line-height: 1.7; font-weight: 400; }

.required { color: #c12638; }
.field-help { color: #68758a; font-size: 24rpx; font-weight: 400; line-height: 1.7; }
.email-options { display: flex; flex-direction: column; gap: 22rpx; }
.email-options label { display: flex; align-items: center; min-height: 56rpx; font-weight: 400; }
.email-options radio { margin-right: 14rpx; flex-shrink: 0; }
