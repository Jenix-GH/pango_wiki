/**index.wxss**/
page {
    height: 100vh;
    display: flex;
    flex-direction: column;
}

.scrollarea {
    flex: 1;
    overflow-y: hidden;
    background-color: white;
    padding-top: 20rpx;
}

.logo {
    width: 100%;
    text-align: center;
    display: flex;
    justify-content: center;
    margin-top: 40%;
}

.logo image {
    height: 60rpx;
    width: 270rpx;
    display: block;
}

.welcome {
    text-align: center;
    margin-top: 30rpx;
    padding: 20rpx;
}

.welcome .title {
    font-size: 110%;
    font-weight: bold;
}

.welcome .mark {
    font-size: 90%;
    padding: 20rpx 50rpx 20rpx 50rpx;
}

.button-group {
    width: 100%;
    text-align: center;
}

.button-group button {
    width: 70%;
    padding: 30rpx;
    margin-top: 50rpx;
    border-radius: 30rpx;
    transition: opacity 0.3s ease-in-out;
    width: 80%;
}

.btn-primary {
    background-color: var(--bg-primary);
    color: white;
}

.btn-auth {
    border: 1px solid var(--bg-primary);
    color: var(--bg-primary);
}

/* 淡入淡出动画类 */
.fade-button {
    opacity: 1;
    animation: fadeIn 0.3s ease-in-out;
}

/* 模拟 wx:if 切换时的淡出（虽然 wx:if 不触发 transition，但可配合数据延迟优化体验） */
@keyframes fadeIn {
    from {
        opacity: 0;
    }

    to {
        opacity: 1;
    }
}

.bottom {
    text-align: center;
    font-size: 90%;
    margin-bottom: 80rpx;
    color: var(--text-dark);
}

.privacy-mask {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 9999;
}

.privacy-dialog {
    width: 80%;
    height: 40%;
    background: white;
    border-radius: 20rpx;
    padding: 30rpx;
    box-sizing: border-box;
    color: var(--text-dark);
}

.privacy-content {
    font-size: 28rpx;
    line-height: 2;
}

.privacy-content view {
    text-indent: 2em;
}

.privacy-link {
    color: var(--bg-primary);
}

.privacy-buttons {
    display: flex;
    justify-content: space-between;
    margin-top: 30rpx;
}
.privacy-title{
    text-align: center; padding: 30rpx; font-weight: bold;
}

.privacy-button {
    flex: 1;
    margin: 0 10rpx;
}