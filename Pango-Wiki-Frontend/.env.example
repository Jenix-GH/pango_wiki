# 生产环境保持同域时，下列前五项均可使用默认值。
VITE_CHAT_BASE_URL=/chat
VITE_CHAT_API_URL=/chat/ragflow-compatible
VITE_DB_BASE_URL=/dbServ
VITE_WIKI_CATALOG_URL=/wiki/api/catalog
VITE_REFERENCE_ORIGIN=

# 仅用于 Vite 本地开发代理，不会进入生产构建。
# 默认均为 https://aiapp.pangomicro.com；需要连接本地后端时再取消注释覆盖。
# 智能问答与 Wiki 后端可分别配置；旧版 VITE_DEV_BACKEND_ORIGIN 仍兼容。
# VITE_DEV_CHAT_BACKEND_ORIGIN=http://127.0.0.1:8000
# VITE_DEV_WIKI_BACKEND_ORIGIN=http://127.0.0.1:8010
